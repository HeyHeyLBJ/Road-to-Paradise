title: National Seat Allocation Test
subtitle: Map
view-if: year = 1928 and month = 2
new-page: true
max-visits: 1
tags: event
on-display: {!
    var toolsWrapper = document.getElementById('tools_wrapper');
    if (toolsWrapper) {
        toolsWrapper.style.display = 'none';
    }
    var wideElements = document.querySelectorAll('header, #content, footer');
    wideElements.forEach(function(el) {
        el.style.maxWidth = '800px';
    });

    var PARTIES = {
        KPD:   { name: "KPD",    color: "#700000" },
        SPD:   { name: "SPD",    color: "#c00000" },
        DDP:   { name: Q.ddp_name || "DDP", color: "#D3C24D" },
        Z:     { name: "Center", color: "#000000" },
        Other: { name: "Other",  color: "#8a8f94" },
        DVP:   { name: "DVP",    color: "#D5AC27" },
        DNVP:  { name: "DNVP",   color: "#3E88B3" },
        NSDAP: { name: "NSDAP",  color: "#7A3C00" }
    };
    var PARTY_LIST = ["KPD","SPD","DDP","Z","Other","DVP","DNVP","NSDAP"]; // left -> right

    var NATIONAL_SHARE = {
        SPD: Q.spd_votes || 0,
        KPD: Q.kpd_votes || 0,
        Z: Q.z_votes || 0,
        DDP: Q.ddp_votes || 0,
        DVP: Q.dvp_votes || 0,
        DNVP: Q.dnvp_votes || 0,
        NSDAP: Q.nsdap_votes || 0,
        Other: Q.other_votes || 0
    };

    function allocateSeats(percentages, totalSeats) {
        var floored = {}, remainders = [], totalFloored = 0;
        for (var p in percentages) {
            var exact = (percentages[p] * totalSeats) / 100;
            var f = Math.floor(exact);
            floored[p] = f;
            totalFloored += f;
            remainders.push({ party: p, remainder: exact - f });
        }
        var remaining = totalSeats - totalFloored;
        remainders.sort(function(a, b) { return b.remainder - a.remainder; });
        for (var i = 0; i < remaining; i++) { floored[remainders[i].party]++; }
        return floored;
    }

    var TOTAL_SEATS = 111; // 110 regular seats + 1 Speaker
    var seatCounts = allocateSeats(NATIONAL_SHARE, TOTAL_SEATS);

    var largestParty = PARTY_LIST.slice().sort(function(a, b) {
        if (seatCounts[b] !== seatCounts[a]) return seatCounts[b] - seatCounts[a];
        return NATIONAL_SHARE[b] - NATIONAL_SHARE[a];
    })[0];

    seatCounts[largestParty] -= 1; // one of their seats becomes the Speaker instead

    var flat = [];
    PARTY_LIST.forEach(function(p) {
        for (var i = 0; i < seatCounts[p]; i++) flat.push(p);
    });

    var holder = document.getElementById("nz-parliament-svg-holder");
    var regularSeats = Array.prototype.slice.call(holder.querySelectorAll('circle[id^="S"]'));

    // sort by the numeric part of each seat id -- this is the order that
    // actually traces a coherent path through the seating layout, confirmed
    // against the raw coordinate data; document order does not.
    regularSeats.sort(function(a, b) {
        return parseInt(a.id.slice(1), 10) - parseInt(b.id.slice(1), 10);
    });

    regularSeats.forEach(function(el, i) {
        var party = flat[i];
        if (!party) return;
        el.style.fill = PARTIES[party].color;
    });

    var speakerEl = holder.querySelector("#Speaker");
    if (speakerEl) {
        speakerEl.style.fill = "none";
        speakerEl.style.stroke = PARTIES[largestParty].color;
        speakerEl.style.strokeWidth = "3";
    }

    var tableHtml = "<table><tr><td>Party</td><td>National vote</td><td>Total seats</td><td>Seat share</td></tr>";
    function renderRow(p) {
        var seatPct = ((seatCounts[p] / TOTAL_SEATS) * 100).toFixed(1);
        var isSpeakerParty = p === largestParty;
        return "<tr><td><div class='box' style='background-color:" + PARTIES[p].color + "; outline: 2px; outline-style: solid;'> </div> " + PARTIES[p].name +
            (isSpeakerParty ? " (+ Speaker)" : "") + "</td>" +
            "<td>" + NATIONAL_SHARE[p].toFixed(1) + "%</td>" +
            "<td>" + seatCounts[p] + (isSpeakerParty ? " + 1" : "") + "</td><td>" + seatPct + "%</td></tr>";
    }
    var withSeats = PARTY_LIST.filter(function(p) { return seatCounts[p] > 0; });
    var withoutSeats = PARTY_LIST.filter(function(p) { return seatCounts[p] === 0; });
    withSeats.forEach(function(p) { tableHtml += renderRow(p); });
    if (withoutSeats.length) {
        tableHtml += "<tr><td colspan='4' style='border-top: 2px solid #182430; padding-top: 6px; color: #5c6b78; font-style: italic;'>No seats</td></tr>";
    }
    withoutSeats.forEach(function(p) { tableHtml += renderRow(p); });
    tableHtml += "</table>";
    document.getElementById("nz-seat-tally").innerHTML = tableHtml;
!}

A test of allocating national seats onto an imported hemicycle SVG, with the largest party giving up one seat to the Speaker.

